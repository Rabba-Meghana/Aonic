# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://novamember:password@localhost:5432/novamember

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Minimum 32 characters. Generate: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-min-32-chars-change-in-production

# Separate secret for refresh tokens. If unset, falls back to JWT_SECRET + '-refresh'
# Best practice: set this independently.
REFRESH_TOKEN_SECRET=your-refresh-token-secret-min-32-chars

# ─── Redis (Upstash) — distributed rate limiting + token revocation ───────────
# Create a free database at https://console.upstash.com
# If unset, an in-memory shim is used (dev/CI only — not safe for production)
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token


# ─── Shopify ──────────────────────────────────────────────────────────────────
SHOPIFY_API_KEY=your-shopify-app-api-key
SHOPIFY_API_SECRET=your-shopify-app-api-secret

# ─── Recharge ─────────────────────────────────────────────────────────────────
RECHARGE_API_KEY=your-recharge-api-key
RECHARGE_WEBHOOK_SECRET=your-recharge-webhook-secret

# ─── Shopify Platform Store (for checkout customer creation) ─────────────────
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STORE_ACCESS_TOKEN=shpat_...

# ─── Shopify Variant IDs (set after creating products in Shopify) ─────────────
SHOPIFY_VARIANT_STARTER=your-shopify-variant-id-starter
SHOPIFY_VARIANT_GROWTH=your-shopify-variant-id-growth
SHOPIFY_VARIANT_SCALE=your-shopify-variant-id-scale

# ─── Recharge Selling Plan IDs (created by installing Recharge on the product,
# NOT something you can generate yourself — copy from the Recharge admin) ─────
SHOPIFY_SELLING_PLAN_STARTER=your-recharge-selling-plan-id-starter
SHOPIFY_SELLING_PLAN_GROWTH=your-recharge-selling-plan-id-growth
SHOPIFY_SELLING_PLAN_SCALE=your-recharge-selling-plan-id-scale

# ─── xAI (Grok) — AI engagement scoring ────────────────────────────────────────
XAI_API_KEY=xai-...

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# https://resend.com — free tier: 100 emails/day, 3000/month
RESEND_API_KEY=re_...
EMAIL_FROM=NovaMember <noreply@novamember.io>

# ─── Eval pipeline ────────────────────────────────────────────────────────────
# Protects POST /api/evals — set this in Vercel dashboard too
# Must match the x-cron-secret header sent by Vercel Cron
CRON_SECRET=your-cron-secret-min-32-chars

# ─── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=info

# Optional: Sentry DSN for error tracking
# SENTRY_DSN=https://xxx@sentry.io/yyy
